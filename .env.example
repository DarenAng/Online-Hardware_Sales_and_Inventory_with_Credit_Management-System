# Copy this file to .env and fill it in. .env is ignored by git.

# --- MySQL (required) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=hardware_db
# A cloud database (Aiven) needs an encrypted connection checked against its
# CA certificate. On a PC, save the certificate as a file and name it here:
#DB_SSL_CA_FILE=aiven-ca.pem
# On Vercel, paste the whole certificate (BEGIN ... END lines included) here instead:
#DB_SSL_CA=
# connections each copy of the server keeps open (default 10; 3 on Vercel)
#DB_CONNECTION_LIMIT=10

# --- Vercel (only when deployed there; see DEPLOY-VERCEL-AIVEN.md) ---
# any long random text; Vercel sends it with the daily job (/api/cron/daily)
#CRON_SECRET=
# the shop's clock. Vercel runs on UTC and will not take TZ, so it is set
# from this (default Asia/Manila on Vercel; a PC keeps its own clock)
#HARDWARE_TIME_ZONE=Asia/Manila
# how often each open screen asks for live updates, in seconds (3 on a PC, 8 on Vercel)
#LIVE_POLL_SECONDS=8
# where backups are kept: folder (backups/ on this PC) or database (the
# backup_files table; the default on Vercel, which has no lasting disk)
#HARDWARE_BACKUP_STORE=folder
# 1 to mark the sign-in cookie https-only behind your own https proxy (always on for Vercel)
#COOKIE_SECURE=0

# --- Server (optional) ---
# the port the app listens on
HARDWARE_PORT=3000
# the longest a sign-in lasts, in hours
SESSION_HOURS=8
# minutes without using the screen before the sign-in ends (the page warns a minute before)
SESSION_IDLE_MINUTES=30
# wrong passwords in a row before an account is held, and for how many minutes
LOGIN_MAX_ATTEMPTS=3
LOGIN_HOLD_MINUTES=15
# 1 only behind a reverse proxy you control (reads X-Forwarded-For for the audit trail)
TRUST_PROXY=0
# where backups are written; default is backups/ in the project folder.
# On a cloud host, point this at a persistent disk or volume.
#HARDWARE_BACKUP_DIR=
# the daily backup: the hour it runs (0-23, server clock), how many automatic
# backups are kept, and how many manual ones may exist at once
#BACKUP_HOUR=2
#BACKUP_KEEP_DAYS=30
#BACKUP_MANUAL_LIMIT=20
# the server's clock; a cloud host usually runs on UTC
#TZ=Asia/Manila

# --- Mail (optional) ---
# The one mail this system sends is the first password of a new account. Leave
# MAIL_USER and MAIL_PASSWORD empty and the password is shown on screen instead.
# Gmail: turn on 2-Step Verification, make an App Password (16 letters) at
# myaccount.google.com/apppasswords and put that in MAIL_PASSWORD.
MAIL_HOST=smtp.gmail.com
# 465 is TLS from the first byte; 587 starts in the clear and upgrades with STARTTLS
MAIL_PORT=465
# defaults to true on 465, false otherwise
#MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
# the name on the From: line; empty means the shop's name from its settings
MAIL_FROM_NAME=
# the shop's web address, linked and printed as a QR code on the purchase
# orders emailed to suppliers. Empty means the address the manager confirmed
# the order from, which a supplier cannot open if it is localhost.
#HARDWARE_SITE_URL=https://lucelyn-hardware.example.com
# set to 1 to switch mail off without clearing the account
#HARDWARE_MAIL_OFF=1

# --- QR payments for GCash and Maya (optional) ---
# The cashier shows a QR code; the customer scans it with their phone and pays.
#   paymongo  real PayMongo. Test or live is decided by the key: sk_test_ is
#             test mode (no real money, a TEST MODE badge on screen), sk_live_
#             is real money.
#   sim       an offline stand-in served by this app: no keys, no internet.
#             Use it for a demo when the internet is down.
PAYMENT_PROVIDER=sim
# dashboard.paymongo.com > Developers > API keys. Only the server reads it;
# it never reaches a browser. Needed when PAYMENT_PROVIDER=paymongo.
PAYMONGO_SECRET_KEY=
# Optional. Make a webhook in the PayMongo dashboard pointing at
# https://<your site>/api/paymongo/webhook (events payment.paid and
# payment.failed) and paste its secret here. PayMongo cannot reach localhost,
# so the till asks PayMongo itself every 3 seconds whether or not this is set.
PAYMONGO_WEBHOOK_SECRET=
# How long a QR code can be paid, in minutes
#QR_PAYMENT_MINUTES=10
# The customer's phone opens links to this app (the simulated pay page, and
# the "you can return to the cashier" page after paying). Without
# HARDWARE_SITE_URL above, the server uses this PC's address on the Wi-Fi
# (shown in the terminal at start-up), so the phone must be on the same Wi-Fi.
# Set to 1 to print PayMongo's raw replies in the terminal (always on with a test key)
#PAYMONGO_LOG=1
