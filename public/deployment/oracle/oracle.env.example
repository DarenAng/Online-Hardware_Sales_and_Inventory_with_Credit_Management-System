# Settings for the app on the Oracle server.
# On the server: cp public/deployment/oracle/oracle.env.example .env   then   nano .env

# The Oracle MySQL DB system (its Private IP address, and the administrator you made)
DB_HOST=10.0.1.xxx
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=the-database-password
DB_NAME=hardware_db

# The app
HARDWARE_PORT=3000
HARDWARE_TIME_ZONE=Asia/Manila
HARDWARE_SITE_URL=https://lucelyn-hardware.duckdns.org
COOKIE_SECURE=1
TRUST_PROXY=1

SESSION_HOURS=8
SESSION_IDLE_MINUTES=30
LOGIN_MAX_ATTEMPTS=3
LOGIN_HOLD_MINUTES=15

# Mail (optional): the Gmail account and App Password that send first passwords and reset codes
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=

# QR payments: sim = the offline simulator, paymongo = PayMongo (needs the keys below)
PAYMENT_PROVIDER=sim
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
#PORTAL_TEST_PAYMENTS=1
